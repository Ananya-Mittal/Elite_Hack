<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme -->
    <style name="Theme.Varchas" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/primary_green</item>
        <item name="colorPrimaryVariant">@color/primary_green_dark</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/primary_green_light</item>
        <item name="colorSecondaryVariant">@color/primary_green</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Error color -->
        <item name="colorError">@color/status_error</item>
        <item name="colorOnError">@color/white</item>

        <!-- Background colors -->
        <item name="android:colorBackground">@color/background_main</item>
        <item name="colorSurface">@color/background_card</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <!-- Status bar color -->
        <item name="android:statusBarColor">@color/primary_green_dark</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>

        <!-- Action bar style -->
        <item name="actionBarStyle">@style/ActionBar.Varchas</item>

        <!-- Text appearances -->
        <item name="textAppearanceHeadline1">@style/TextAppearance.Varchas.Headline1</item>
        <item name="textAppearanceHeadline2">@style/TextAppearance.Varchas.Headline2</item>
        <item name="textAppearanceBody1">@style/TextAppearance.Varchas.Body1</item>
        <item name="textAppearanceBody2">@style/TextAppearance.Varchas.Body2</item>

        <!-- Button style -->
        <item name="materialButtonStyle">@style/Button.Varchas</item>
    </style>

    <!-- ActionBar Style -->
    <style name="ActionBar.Varchas" parent="Widget.MaterialComponents.ActionBar.Primary">
        <item name="background">@color/primary_green</item>
        <item name="titleTextStyle">@style/ActionBar.Varchas.Title</item>
        <item name="elevation">4dp</item>
    </style>

    <style name="ActionBar.Varchas.Title" parent="TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Text Appearances -->
    <style name="TextAppearance.Varchas.Headline1" parent="TextAppearance.MaterialComponents.Headline1">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">28sp</item>
        <item name="fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.Varchas.Headline2" parent="TextAppearance.MaterialComponents.Headline2">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">18sp</item>
        <item name="fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.Varchas.Body1" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextAppearance.Varchas.Body2" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Button Style -->
    <style name="Button.Varchas" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/primary_green</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">56dp</item>
        <item name="elevation">4dp</item>
    </style>

    <!-- CardView Style -->
    <style name="CardView.Varchas" parent="CardView">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">6dp</item>
        <item name="cardBackgroundColor">@color/background_card</item>
        <item name="contentPadding">20dp</item>
    </style>

    <!-- TextInputLayout Style -->
    <style name="TextInputLayout.Varchas" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/primary_green</item>
        <item name="hintTextColor">@color/primary_green</item>
        <item name="boxStrokeWidth">2dp</item>
        <item name="boxCornerRadiusTopStart">8dp</item>
        <item name="boxCornerRadiusTopEnd">8dp</item>
        <item name="boxCornerRadiusBottomStart">8dp</item>
        <item name="boxCornerRadiusBottomEnd">8dp</item>
    </style>

    <!-- RadioButton Style -->
    <style name="RadioButton.Varchas" parent="Widget.MaterialComponents.CompoundButton.RadioButton">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:buttonTint">@color/primary_green</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>