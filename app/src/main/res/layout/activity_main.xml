<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/tvAppTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌾 Agri Credit Scoring"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#2E7D32"
                android:gravity="center"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvAppSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Smart Loan Assessment for Farmers"
                android:textSize="14sp"
                android:textColor="#666666"
                android:gravity="center"/>
        </LinearLayout>

        <!-- Input Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cvInputSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@android:color/white"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Section Title -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Farm Location"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#212121"
                    android:layout_marginBottom="16dp"/>

                <!-- Latitude Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilLatitude"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Latitude"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    app:boxStrokeColor="#2E7D32"
                    app:hintTextColor="#2E7D32"
                    app:boxStrokeWidth="2dp"
                    app:boxCornerRadiusTopStart="8dp"
                    app:boxCornerRadiusTopEnd="8dp"
                    app:boxCornerRadiusBottomStart="8dp"
                    app:boxCornerRadiusBottomEnd="8dp"
                    android:layout_marginBottom="12dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etLatitude"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal|numberSigned"
                        android:text="28.6139"
                        android:textSize="16sp"
                        android:textColor="#212121"
                        android:maxLines="1"
                        android:imeOptions="actionNext"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Longitude Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilLongitude"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Longitude"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    app:boxStrokeColor="#2E7D32"
                    app:hintTextColor="#2E7D32"
                    app:boxStrokeWidth="2dp"
                    app:boxCornerRadiusTopStart="8dp"
                    app:boxCornerRadiusTopEnd="8dp"
                    app:boxCornerRadiusBottomStart="8dp"
                    app:boxCornerRadiusBottomEnd="8dp"
                    android:layout_marginBottom="20dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etLongitude"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal|numberSigned"
                        android:text="77.2090"
                        android:textSize="16sp"
                        android:textColor="#212121"
                        android:maxLines="1"
                        android:imeOptions="actionDone"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Crop Selection Label -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Select Crop Type"
                    android:textSize="15sp"
                    android:textColor="#757575"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"/>

                <!-- Crop Selection Radio Group -->
                <RadioGroup
                    android:id="@+id/rgCropType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="#F5F5F5"
                    android:padding="4dp">

                    <RadioButton
                        android:id="@+id/rbWheat"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="🌾 Wheat"
                        android:checked="true"
                        android:textSize="16sp"
                        android:textColor="#212121"
                        android:buttonTint="#2E7D32"
                        android:layout_marginEnd="4dp"/>

                    <RadioButton
                        android:id="@+id/rbRice"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="🌾 Rice"
                        android:textSize="16sp"
                        android:textColor="#212121"
                        android:buttonTint="#2E7D32"
                        android:layout_marginStart="4dp"/>
                </RadioGroup>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Calculate Button -->
        <Button
            android:id="@+id/btnCalculate"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Calculate Credit Score"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:backgroundTint="#2E7D32"
            android:elevation="4dp"
            android:stateListAnimator="@null"
            app:cornerRadius="12dp"
            android:layout_marginBottom="20dp"/>

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:visibility="gone"
            android:indeterminateTint="#2E7D32"
            android:layout_marginBottom="20dp"
            tools:visibility="visible"/>

        <!-- Results Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cvResults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@android:color/white"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Score Display Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#E8F5E9"
                    android:padding="20dp"
                    android:gravity="center"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Credit Score"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#2E7D32"
                        android:layout_marginBottom="8dp"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvScore"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="85"
                            android:textSize="48sp"
                            android:textStyle="bold"
                            android:textColor="#2E7D32"
                            tools:text="85"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="/100"
                            android:textSize="20sp"
                            android:textColor="#757575"
                            android:layout_marginStart="4dp"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Decision Status -->
                <TextView
                    android:id="@+id/tvDecision"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="✅ Approved"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#2E7D32"
                    android:gravity="center"
                    android:padding="16dp"
                    android:background="#E8F5E9"
                    android:layout_marginBottom="20dp"
                    tools:text="✅ Approved"/>

                <!-- Financial Summary Section -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Financial Summary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#212121"
                    android:layout_marginBottom="12dp"/>

                <!-- Loan Limit Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:background="#FAFAFA"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Loan Limit:"
                        android:textSize="16sp"
                        android:textColor="#757575"/>

                    <TextView
                        android:id="@+id/tvLoanLimit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹50,000"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#212121"
                        tools:text="₹50,000"/>
                </LinearLayout>

                <!-- Revenue Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:background="#FAFAFA"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Est. Revenue:"
                        android:textSize="16sp"
                        android:textColor="#757575"/>

                    <TextView
                        android:id="@+id/tvRevenue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹83,333"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#212121"
                        tools:text="₹83,333"/>
                </LinearLayout>

                <!-- Yield Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:background="#FAFAFA"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Est. Yield:"
                        android:textSize="16sp"
                        android:textColor="#757575"/>

                    <TextView
                        android:id="@+id/tvYield"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3.79 tons"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#212121"
                        tools:text="3.79 tons"/>
                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E0E0E0"
                    android:layout_marginVertical="16dp"/>

                <!-- Farm Health Section -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Farm Health Analysis"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#212121"
                    android:layout_marginBottom="12dp"/>

                <!-- Crop Health Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:background="#FAFAFA"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Crop Health:"
                        android:textSize="15sp"
                        android:textColor="#757575"/>

                    <TextView
                        android:id="@+id/tvCropHealth"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Good"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#2E7D32"
                        tools:text="Good"/>
                </LinearLayout>

                <!-- Weather Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:background="#FAFAFA"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Weather:"
                        android:textSize="15sp"
                        android:textColor="#757575"/>

                    <TextView
                        android:id="@+id/tvWeather"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Normal"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#2E7D32"
                        tools:text="Normal"/>
                </LinearLayout>

                <!-- Soil Status Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:background="#FAFAFA"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Soil Status:"
                        android:textSize="15sp"
                        android:textColor="#757575"/>

                    <TextView
                        android:id="@+id/tvSoilStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Healthy Soil"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#2E7D32"
                        tools:text="Healthy Soil"/>
                </LinearLayout>

                <!-- NDVI Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:background="#FAFAFA"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="NDVI:"
                        android:textSize="15sp"
                        android:textColor="#757575"/>

                    <TextView
                        android:id="@+id/tvNDVI"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.69"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#212121"
                        tools:text="0.69"/>
                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E0E0E0"
                    android:layout_marginVertical="16dp"/>

                <!-- Score Factors Section -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Score Factors"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#212121"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:id="@+id/tvReasons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Loading..."
                    android:textSize="15sp"
                    android:textColor="#757575"
                    android:lineSpacingExtra="6dp"
                    android:padding="12dp"
                    android:background="#FAFAFA"
                    tools:text="• Consistent crop health\n• Stable rainfall\n• Healthy soil moisture\n• Good repayment capacity"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>